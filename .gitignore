.idea

# Local env files
.env
.env.*
!.env.example

# Local project data (automations, memory, brand backups) — not for the repo
.workbuddy/

# public/icons/ is intentionally committed. It is the site's favicon asset set,
# not a disposable build output: clean-checkout builds (CI / Cloudflare Pages)
# cannot fetch icons at build time, so omitting it makes every card fall back
# to a letter block. Regenerate with `npm run icons` after adding sites.

# TypeScript / build caches
*.tsbuildinfo

# OS / editor cruft
Thumbs.db
.vercel

# Local env overrides
.env.local
.env.*.local

# Coverage / test reports
coverage/
